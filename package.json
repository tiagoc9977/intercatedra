{
  "name": "simulador-procesos-memoria",
  "version": "0.1.0",
  "description": "Biblioteca TypeScript que simula procesos, memoria contigua y planificación Round-Robin (AE2 Paradigmas II + Sistemas Operativos, UCP)",
  "main": "dist/src/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
