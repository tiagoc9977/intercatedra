    "build": "tsc"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "types": "dist/src/index.d.ts",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
